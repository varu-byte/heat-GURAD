# PORT: Local server port (defaults to 3000 if unset).
# No API key is required for Open-Meteo live weather.
PORT=3000

# GEMINI_API_KEY: Server-side key for AI heat-risk trend analysis (never exposed to browser).
GEMINI_API_KEY=

# APP_URL: Optional public URL when deployed.
APP_URL="http://localhost:3000"

# VITE_FIREBASE_VAPID_KEY: Optional Web Push VAPID public key from Firebase Console -> Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=

# Server-Side Custom HTTP SMS Gateway (keep strictly server-side; never prefix with VITE_)
# When set, server sends POST JSON { "to": "+91...", "message": "..." } with Authorization: Bearer <SMS_API_KEY>.
# When unset, alerts run cleanly in local fallback mode with direct WhatsApp / SMS phone links in the UI.
SMS_API_URL=
SMS_API_KEY=

# Optional Firebase Cloud Messaging HTTP v1 / Legacy Server Key (server-side only)
FCM_SERVER_KEY=
